FROM registry.access.redhat.com/hi/python:3.13-builder AS builder
USER 0
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_PREFERENCE=only-system

COPY --from=ghcr.io/astral-sh/uv /uv /bin/uv

WORKDIR /app

ADD libs /app/libs
ADD services /app/services
ADD .python-version /app
ADD pyproject.toml /app
ADD uv.lock /app
ADD docker/requirements-build.txt /app/
ADD docker/requirements-watson-extension.txt /app/

RUN if [ -f /cachi2/cachi2.env ]; then \
      . /cachi2/cachi2.env && \
      python3 -m venv .venv && \
      .venv/bin/pip install -r requirements-build.txt && \
      .venv/bin/pip install --no-build-isolation -r requirements-watson-extension.txt && \
      .venv/bin/pip install --no-deps --no-build-isolation \
        . ./libs/common ./services/watson-extension; \
    else \
      uv sync --frozen --no-dev --no-editable --directory services/watson-extension; \
    fi

FROM registry.access.redhat.com/hi/python:3.13
WORKDIR /app

# Copy the application from the builder
COPY --from=builder /app/services/watson-extension/src /app
COPY --from=builder /app/.venv /app/.venv

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"

USER 1001
