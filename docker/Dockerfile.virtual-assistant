FROM registry.access.redhat.com/hi/python:3.13-builder AS builder
USER 0
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_PREFERENCE=only-system

COPY --from=ghcr.io/astral-sh/uv /uv /bin/uv

WORKDIR /app

ADD libs /app/libs
ADD services /app/services
ADD .python-version /app
ADD pyproject.toml /app
ADD uv.lock /app
ADD docker/requirements-virtual-assistant.txt /app/

RUN if [ -f /cachi2/cachi2.env ]; then \
      . /cachi2/cachi2.env && \
      python3 -m venv --system-site-packages .venv && \
      .venv/bin/pip install -r requirements-virtual-assistant.txt && \
      .venv/bin/pip install --no-deps --no-build-isolation \
        . ./libs/common ./services/virtual-assistant && \
      sed -i 's/include-system-site-packages = true/include-system-site-packages = false/' \
        .venv/pyvenv.cfg; \
    else \
      uv sync --frozen --no-dev --no-editable --directory services/virtual-assistant; \
    fi

FROM registry.access.redhat.com/hi/python:3.13
WORKDIR /app

# Copy the application from the builder
COPY --from=builder /app/services/virtual-assistant/src /app
COPY --from=builder /app/.venv /app/.venv

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"

USER 1001
